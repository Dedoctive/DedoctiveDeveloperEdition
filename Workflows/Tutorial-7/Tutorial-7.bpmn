      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06fklxf_di" bpmnElement="Flow_06fklxf">
        <di:waypoint x="820" y="220" />
        <di:waypoint x="865" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0k5vgbb_di" bpmnElement="Flow_0k5vgbb">
        <di:waypoint x="890" y="195" />
        <di:waypoint x="890" y="130" />
        <di:waypoint x="420" y="130" />
        <di:waypoint x="420" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="807" y="96" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05gezir_di" bpmnElement="Flow_05gezir">
        <di:waypoint x="915" y="220" />
