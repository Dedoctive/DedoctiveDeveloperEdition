          <dc:Bounds x="1035.5" y="178" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0cakts7_di" bpmnElement="LLMAgent">
        <dc:Bounds x="370" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_10i1gxa_di" bpmnElement="UserInput">
        <dc:Bounds x="720" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_07rrjz0_di" bpmnElement="Gateway_07rrjz0" isMarkerVisible="true">
        <dc:Bounds x="535" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1d6wq5g_di" bpmnElement="Gateway_1d6wq5g" isMarkerVisible="true">
        <dc:Bounds x="865" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1xnhtkg_di" bpmnElement="Flow_1xnhtkg">
        <di:waypoint x="278" y="220" />
        <di:waypoint x="370" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0us7zky_di" bpmnElement="Flow_0us7zky">
        <di:waypoint x="470" y="220" />
        <di:waypoint x="535" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1f4q1re_di" bpmnElement="Flow_1f4q1re">
        <di:waypoint x="585" y="220" />
        <di:waypoint x="720" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="609" y="202" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_190tt3c_di" bpmnElement="Flow_190tt3c">
        <di:waypoint x="560" y="245" />
        <di:waypoint x="560" y="300" />
        <di:waypoint x="1060" y="300" />
        <di:waypoint x="1060" y="238" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="618" y="306" width="69" height="27" />
